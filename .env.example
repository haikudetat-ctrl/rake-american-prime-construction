# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://jfonoearbpcqsofkmqvr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://your-deployment.example      # used in texts and the customer link
CRON_SECRET=                                 # Vercel Cron bearer token
INTAKE_SECRET=                               # any long random string; signs the request form

# Google Geocoding (request link + job addresses). Optional: without it,
# addresses are stored as typed and runs are grouped by town only.
GOOGLE_MAPS_API_KEY=

# Twilio Messaging (texts). Optional: without it, texts wait in the outbox.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=

# Resend (statements and reminders). Optional: without it, emails wait in the outbox.
RESEND_API_KEY=
EMAIL_FROM=billing@your-domain.example

# QuickBooks Online (Intuit developer app → Keys & credentials). Optional:
# without these the Settings card says "not set up" and nothing calls Intuit.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=                           # never commit; server-side only
QBO_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
QBO_ENVIRONMENT=sandbox                      # or production
QBO_TOKEN_KEY=                               # openssl rand -base64 32 — encrypts stored tokens
# Business phone (phase 2b): the Account Auth Token, used only to verify that
# webhooks really come from Twilio (Console → Account → API keys & tokens).
TWILIO_AUTH_TOKEN=
